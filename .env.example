# URA-Shree deployment configuration.
#
# Copy to .env and edit. Every value below is a default, except the ones marked
# REQUIRED, which the server refuses to start without in cloud mode.

# -- mode ---------------------------------------------------------------------
# "local" keeps the single-user behaviour: no login, execution on the host.
# "cloud" turns on authentication, the database, container sandboxes and limits.
SHREE_MODE=cloud

# -- identity (REQUIRED in cloud mode) ----------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every replica must share the same value or tokens stop verifying between them.
SHREE_JWT_SECRET=
SHREE_ACCESS_TOKEN_TTL=3600
SHREE_REFRESH_TOKEN_TTL=2592000
# The first account is always allowed, so a new deployment can be claimed.
# Set to 0 after that to make further accounts invite-only.
SHREE_ALLOW_SIGNUP=1

# Optional OAuth2 sign-in. Leave blank to offer password login only.
SHREE_OAUTH_REDIRECT_BASE=https://shree.example.com
SHREE_GITHUB_CLIENT_ID=
SHREE_GITHUB_CLIENT_SECRET=
SHREE_GOOGLE_CLIENT_ID=
SHREE_GOOGLE_CLIENT_SECRET=

# -- storage ------------------------------------------------------------------
SHREE_DATABASE_URL=postgresql+psycopg://shree:shree@postgres:5432/shree
SHREE_REDIS_URL=redis://redis:6379/0

# Snapshot blobs. Leave blank to keep them on the workspace volume; set it when
# more than one replica has to read the same history.
SHREE_OBJECT_STORE_URL=s3://shree-snapshots/timemachine
SHREE_S3_ENDPOINT_URL=http://minio:9000
SHREE_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Parent directory of every tenant workspace volume.
SHREE_WORKSPACES_ROOT=/var/lib/shree/workspaces

# -- execution sandbox --------------------------------------------------------
# "container" gives each session its own ephemeral Docker sandbox.
SHREE_EXECUTION_DRIVER=container
SHREE_SANDBOX_IMAGE=shree-sandbox:latest
SHREE_SANDBOX_CPUS=1.0
SHREE_SANDBOX_MEMORY_MB=2048
SHREE_SANDBOX_PIDS=256
# "none" blocks all egress from the sandbox. Change it only if the agent
# genuinely needs to reach a package registry, and prefer a proxied network
# over "bridge".
SHREE_SANDBOX_NETWORK=none
# Seconds of inactivity before a sandbox is destroyed.
SHREE_SESSION_IDLE_TIMEOUT=1800
SHREE_REAPER_INTERVAL=120

# -- limits (requests/seconds) ------------------------------------------------
SHREE_RATE_API=600/60
SHREE_RATE_SCAN=10/60
SHREE_RATE_CHAT=60/60
SHREE_RATE_WS=120/60

# -- web ----------------------------------------------------------------------
SHREE_ALLOWED_ORIGINS=https://shree.example.com
# Only enable behind a proxy that overwrites X-Forwarded-For. Otherwise a
# client can forge its own rate-limit bucket.
SHREE_TRUST_PROXY=1
# The native folder picker draws a window on the server. Local installs only.
SHREE_ALLOW_HOST_PICKER=0

# -- observability ------------------------------------------------------------
SHREE_LOG_LEVEL=INFO
SHREE_LOG_JSON=1
OTEL_SERVICE_NAME=ura-shree
OTEL_EXPORTER_OTLP_ENDPOINT=

# -- frontend build -----------------------------------------------------------
# Baked in at build time. Leave blank to call the same origin that served the
# page, which is what the reverse proxy setup wants.
VITE_API_BASE_URL=
