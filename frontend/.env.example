# Frontend build-time configuration.
#
# Vite inlines these at build time, so they are baked into the bundle and are
# public. Never put a secret here.
#
#   cp frontend/.env.example frontend/.env.local

# Where the API lives. Leave empty to call the same origin that served the
# page, which is what both the dev proxy and the nginx deployment want. Set it
# only when the frontend is hosted separately from the API, for example on a
# CDN:
#   VITE_API_BASE_URL=https://api.shree.example.com
VITE_API_BASE_URL=
